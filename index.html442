
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Someone Special 💗</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;min-height:100vh;text-align:center;
 font-family:Georgia,serif;color:#713e58;
 background:linear-gradient(135deg,#ffe5ef,#fff0d9,#f5e4ff);
 overflow-x:hidden
}
.screen{display:none;min-height:100vh;padding:35px 15px;
 align-items:center;justify-content:center;flex-direction:column}
.screen.active{display:flex;animation:appear .8s}
@keyframes appear{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
h1{font-size:clamp(30px,8vw,48px);margin:15px 0}
p{font-size:18px;line-height:1.6;max-width:450px}
button{border:0;border-radius:30px;padding:14px 24px;
 background:#ff77a8;color:white;font-size:17px;cursor:pointer;
 box-shadow:0 5px 15px #e99ab755;margin:10px}
button:active{transform:scale(.96)}
.envelope{font-size:100px;animation:bob 1.5s infinite}
@keyframes bob{50%{transform:translateY(-10px)}}
.balloons{display:grid;grid-template-columns:repeat(2,minmax(110px,140px));gap:22px}
.balloon{height:155px;border-radius:50% 50% 45% 45%;
 display:flex;align-items:center;justify-content:center;
 color:white;font:bold 45px Georgia;position:relative;
 box-shadow:inset -10px -8px 0 #00000010;animation:bob 2s infinite}
.balloon:after{content:"";position:absolute;bottom:-28px;width:2px;height:30px;background:#b58b99}
.b1{background:#ff739c}.b2{background:#a78bfa}
.b3{background:#ffad69}.b4{background:#62c9c2}
.balloon.popped{visibility:hidden;animation:none}
.cake{font-size:115px;cursor:pointer;filter:drop-shadow(0 8px 8px #d79caa55)}
.kittens{display:grid;grid-template-columns:repeat(2,minmax(110px,145px));gap:15px}
.kitty{font-size:72px;background:#ffffff80;border-radius:25px;padding:15px;
 animation:dance .7s infinite alternate}
.kitty:nth-child(even){animation-delay:.3s}
@keyframes dance{to{transform:rotate(9deg) translateY(-9px)}}
#confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.conf{position:absolute;top:-20px;animation:fall 3s linear forwards;font-size:24px}
@keyframes fall{to{transform:translateY(110vh) rotate(500deg)}}
.note{background:#ffffffa8;border-radius:25px;padding:22px;max-width:440px;
 box-shadow:0 10px 35px #b47c9a22}
.small{font-size:14px;opacity:.8}
</style>
</head>
<body>
<div id="confetti"></div>

<section class="screen active" id="s1">
 <div class="envelope">💌</div>
 <p>A little surprise has been made just for you...</p>
 <h1>Hey, Birthday Girl! 💗</h1>
 <p>Someone has something special to tell you.</p>
 <button onclick="go(2)">Open your letter 💌</button>
</section>

<section class="screen" id="s2">
 <div class="note">
  <div style="font-size:65px">💌🌷</div>
  <h1>Dear You,</h1>
  <p>Today is all about you! ✨</p>
  <p>I hope your day is full of little surprises, happy moments, laughter, and all the things that make you smile.</p>
  <p>Ready for the next surprise? 🎈</p>
 </div>
 <button onclick="go(3)">Let's go! 🎈</button>
</section>

<section class="screen" id="s3">
 <h1>Pop the balloons! 🎈</h1>
 <p>Tap all four balloons to unlock your birthday surprise.</p>
 <div class="balloons">
  <div class="balloon b1" onclick="pop(this)">B</div>
  <div class="balloon b2" onclick="pop(this)">D</div>
  <div class="balloon b3" onclick="pop(this)">A</div>
  <div class="balloon b4" onclick="pop(this)">Y</div>
 </div>
 <p id="count">4 balloons left 💕</p>
 <button id="next" style="display:none" onclick="go(4)">What's next? 🎂</button>
</section>

<section class="screen" id="s4">
 <h1>A cake just for you! 🎂</h1>
 <p>Tap the cake to make a wish ✨</p>
 <div class="cake" onclick="cakeWish()">🎂</div>
 <p id="cakeMsg">Make your sweetest birthday wish! 💗</p>
 <button id="cakeNext" style="display:none" onclick="go(5)">Time to party! 🎉</button>
</section>

<section class="screen" id="s5">
 <h1>The birthday crew is here! 🐱</h1>
 <p>Four tiny guests came to celebrate YOU! 🎉</p>
 <div class="kittens">
  <div class="kitty">🐱</div>
  <div class="kitty">😺</div>
  <div class="kitty">😸</div>
  <div class="kitty">🐈</div>
 </div>
 <p>Dance, little kitties, dance! 💃</p>
 <button onclick="go(6);celebrate()">One last surprise 💖</button>
</section>

<section class="screen" id="s6">
 <div style="font-size:75px">💗🎂💗</div>
 <h1>Happy Birthday! 🎉</h1>
 <div class="note">
  <p>May your smile shine brighter than every candle on this cake.</p>
  <p>May this new year bring you beautiful memories, endless happiness, and lots of reasons to smile. 🌷✨</p>
  <h2>Stay magical, birthday girl! 💕</h2>
  <p class="small">Made with a little extra love 💌</p>
 </div>
 <button onclick="celebrate()">Celebrate again! 🎊</button>
</section>

<script>
function go(n){
 document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
 document.getElementById('s'+n).classList.add('active');
 window.scrollTo(0,0);
 if(n===5) celebrate();
}
let popped=0;
function pop(el){
 if(el.classList.contains('popped'))return;
 el.classList.add('popped');popped++;
 document.getElementById('count').textContent=
  popped===4?'All popped! Surprise unlocked! 💖':(4-popped)+' balloons left 💕';
 if(popped===4)document.getElementById('next').style.display='inline-block';
}
let wished=false;
function cakeWish(){
 if(wished)return;
 wished=true;
 document.getElementById('cakeMsg').textContent='Wish made! May it come true! ✨💖';
 document.getElementById('cakeNext').style.display='inline-block';
 celebrate();
}
function celebrate(){
 const area=document.getElementById('confetti');
 const bits=['💖','💕','✨','🎉','🌸','🎊'];
 for(let i=0;i<32;i++){
  const e=document.createElement('span');
  e.className='conf';e.textContent=bits[Math.floor(Math.random()*bits.length)];
  e.style.left=Math.random()*100+'%';
  e.style.animationDelay=Math.random()*1.5+'s';
  area.appendChild(e);
  setTimeout(()=>e.remove(),5000);
 }
}
</script>
</body>
</html>
